{
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "dist",
    "inlineSources": true,
    "esModuleInterop": true,
    "lib": ["DOM", "ES2020"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist",
    "rootDir": "./src",
    "sourceMap": true,
    "strict": true,
    "target": "ES2017"
  },
  "include": ["src/**/*.ts", "src/**/*.test.ts"]
}
